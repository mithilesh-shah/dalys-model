max_x <- apply(abs(X),2,max)
X_norm <- X
for (cc in 1:ncol(X)){
X_norm[,cc] <- X[,cc]/max_x[cc]
}
# Store error at each epoch
error <- rep(0, niters)
# Set up weights (biases are included in)
# the +1 is to add in the intercept/bias parameter
W1 <- matrix(runif(ncol(X_norm)*K, -1, 1), nrow = ncol(X))
W2 <- matrix(runif((K+1)*ncol(y_norm), -1, 1), nrow = K+1)
# Or load previous weights
if (FALSE){
#saveRDS(W1, str_c("W1_K",K,".rds"))
#saveRDS(W2, str_c("W2_K",K,".rds"))
W1 <- readRDS(str_c("W1_K",K,".rds"))
W2 <- readRDS(str_c("W2_K",K,".rds"))
}
ii<-1
# Calculate the hidden and output layers using X_norm and hidden layer as inputs
# hidden A layer has a column of ones appended for the bias term
A <- cbind(matrix(1, nrow = nrow(X_norm)), sigmoid(X_norm %*% W1))
y_hat <- A %*% W2
A
y_hat <- A %*% W2
# Calculate the gradient
y_hat_del <- (y_norm-y_hat)
hidden1_del <- (y_hat_del %*% t(W2)) *d.sigmoid(A)
# Update the weights
hidden1_del
(y_hat_del %*% t(W2))
d.sigmoid(A)
dim(d.sigmoid(A))
dim((y_hat_del %*% t(W2)))
